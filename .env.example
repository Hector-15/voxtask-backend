# Copia este archivo a .env para desarrollo local. En producción, define estas
# variables en el panel de tu proveedor (Render/Railway), no en un archivo.

# Clave para firmar los tokens. En producción usa una cadena larga y aleatoria.
SECRET_KEY=genera_una_cadena_larga_y_aleatoria_aqui

# Base de datos. Local: SQLite. Producción: el proveedor inyecta una de Postgres.
DATABASE_URL=sqlite:///./voxtask.db
# DATABASE_URL=postgresql://user:pass@host:5432/voxtask

# Opcional: si se define, el motor NLP puede usar el LLM.
# Si se deja vacío, usa el parser de reglas (offline).
ANTHROPIC_API_KEY=
NLP_MODEL=claude-sonnet-4-6

# Orígenes CORS permitidos (separa con comas, o "*" para cualquiera).
CORS_ORIGINS=*

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
